entrypoint = "README.md"
modules = ["python-3.12", "web", "postgresql-16", "nodejs-22"]

[nix]
channel = "stable-25_05"
packages = ["unzip", "glib", "nspr", "nss", "atk", "cups", "libdrm", "mesa", "expat", "alsa-lib", "pango", "cairo", "at-spi2-atk", "at-spi2-core", "dbus", "gtk3", "xorg.libxcb", "xorg.libX11", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXtst", "xorg.libxkbfile"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 18789
externalPort = 3000

[env]
PORT = "5000"

[agent]
stack = "EXPO"
integrations = ["javascript_database:1.0.0", "javascript_openai:1.0.0", "google-calendar:1.0.0"]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start dev servers"

[[workflows.workflow]]
name = "Start dev servers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run all:dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
ADMIN_SECRET = "dentcor-admin-2026"
AI_INTEGRATIONS_ANTHROPIC_BASE_URL = "http://localhost:1106/modelfarm/anthropic"
AI_INTEGRATIONS_ANTHROPIC_API_KEY = "_DUMMY_API_KEY_"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

