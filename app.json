{
  "expo": {
    "name": "Здоровье Зубов",
    "slug": "dental-health",
    "version": "1.0.0",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dentalhealth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dentalhealth.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0097A7",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dentalhealth.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0097A7",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
