{
  "name": "my-app",
  "main": "client/index.js",
  "version": "1.0.0",
  "scripts": {
    "expo:dev": "EXPO_NO_REACT_NATIVE_DEVTOOLS=1 EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN bash -c '(printf \"\\x1b[B\\n\"; sleep infinity) | npx expo start --localhost --clear'",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "openclaw:dev": "fuser -k 18789/tcp 2>/dev/null; openclaw gateway --port 18789 --allow-unconfigured --auth none 2>/dev/null || true",
    "all:dev": "fuser -k 5000/tcp 8081/tcp 18789/tcp 2>/dev/null; echo \"EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN\" > .env.local; sleep 1; npm run openclaw:dev & sleep 4; npm run expo:dev & npm run server:dev",
    "expo:start:static:build": "EXPO_PUBLIC_DOMAIN=$REPLIT_INTERNAL_APP_DOMAIN npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts server/migrate.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "server:migrate:prod": "node server_dist/migrate.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@tanstack/react-query": "^5.90.7",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "esbuild": "^0.27.3",
    "expo": "~55.0.9",
    "expo-av": "^16.0.8",
    "expo-blur": "~55.0.12",
    "expo-calendar": "~55.0.12",
    "expo-constants": "~55.0.11",
    "expo-crypto": "~55.0.12",
    "expo-document-picker": "~55.0.11",
    "expo-file-system": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-haptics": "~55.0.11",
    "expo-image": "~55.0.8",
    "expo-image-picker": "~55.0.16",
    "expo-linear-gradient": "~55.0.11",
    "expo-linking": "~55.0.11",
    "expo-localization": "~55.0.11",
    "expo-notifications": "~55.0.16",
    "expo-secure-store": "~55.0.11",
    "expo-sharing": "~55.0.16",
    "expo-splash-screen": "~55.0.15",
    "expo-sqlite": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.13",
    "expo-web-browser": "~55.0.12",
    "express": "^4.22.1",
    "googleapis": "^148.0.0",
    "http-proxy-middleware": "^3.0.5",
    "i18next": "^25.8.17",
    "openai": "^6.35.0",
    "openclaw": "^2026.5.2",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "pg": "^8.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.6",
    "react-native": "^0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "resend": "^6.12.2",
    "tsx": "^4.21.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/express": "^4.17.21",
    "@types/node": "24.10.0",
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
